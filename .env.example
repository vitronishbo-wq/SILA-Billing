# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# SILA-Billing — Backend Administrativo (Render / Node.js Express)
# ------------------------------------------------------------------
# Projeto Firebase e Base de Dados Firestore nomeada obrigatória:
FIREBASE_PROJECT_ID="gen-lang-client-0982515821"
FIREBASE_DATABASE_ID="ai-studio-49352535-85f6-4187-bf2b-3e420dac8a25"

# Credencial Administrativa Firebase Admin SDK (escolha UMA das duas no Render):
# Opção A: JSON minificado numa única linha (suporta \n escapados na private_key)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Opção B: Conteúdo completo do Service Account JSON codificado em Base64
FIREBASE_CREDENTIALS_BASE64=""

# Origens permitidas no CORS (separadas por vírgula; ex: https://gen-lang-client-0982515821.web.app)
CORS_ORIGINS=""

# ------------------------------------------------------------------
# SILA-Billing — Frontend PWA (Vite / Firebase Hosting)
# ------------------------------------------------------------------
# URL base do backend no Render (vazio em desenvolvimento / full-stack unificado para usar /api relativo)
VITE_API_BASE_URL=""
