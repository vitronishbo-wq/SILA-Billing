# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# SILA-Billing — Backend Administrativo (Render / Node.js Express)
# ------------------------------------------------------------------
# Projeto Firebase e Base de Dados Firestore nomeada obrigatória:
FIREBASE_PROJECT_ID="gen-lang-client-0982515821"
FIREBASE_DATABASE_ID="ai-studio-49352535-85f6-4187-bf2b-3e420dac8a25"

# Credencial Administrativa Firebase Admin SDK (suporta tanto Base64 como JSON minificado):
# No Render pode definir FIREBASE_SERVICE_ACCOUNT_JSON com a string Base64 ou JSON numa linha
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Alternativa equivalente explícita para Base64:
FIREBASE_CREDENTIALS_BASE64=""

# Origens permitidas no CORS (separadas por vírgula; ex: https://silabilling.web.app,https://silabilling.firebaseapp.com)
CORS_ORIGINS="https://silabilling.web.app,https://silabilling.firebaseapp.com"

# Emails adicionais autorizados no Painel Master SILA-Billing (separados por vírgula; requer email verificado no Firebase Auth)
PLATFORM_ADMIN_EMAILS=""

# ------------------------------------------------------------------
# SILA-Billing — Frontend PWA (Vite / Firebase Hosting: https://silabilling.web.app)
# ------------------------------------------------------------------
# URL base do backend no Render (em produção assume automaticamente https://sila-billing.onrender.com; vazio em dev local)
VITE_API_BASE_URL=""
